# Public constants of the release pipeline. Reviewed like code: the build refuses to sign a
# release with anything else, and a verifier checks the bundle against these values.
# KEY=VALUE only — shell scripts source this file and Python parses it.

# The Apple Developer team the signing certificate must belong to.
FIDOPASS_TEAM_ID=CQFSNU7PVS

# Sparkle's EdDSA public key, base64 (44 characters), written into Info.plist as
# SUPublicEDKey. Made once with scripts/sparkle_keygen.swift (docs/release.md). The private
# half lives only in the GitHub environment secret SPARKLE_PRIVATE_KEY and in the
# maintainer's offline backup. A Developer ID build refuses to proceed while this is empty.
SPARKLE_PUBLIC_KEY=jt6SHdxlh762nNMwk6nW1KIRvoUOGO8FbJX58MGxQrc=

# Where a released app looks for updates. Only Developer ID builds carry it.
SPARKLE_FEED_URL=https://github.com/exa-pub/FidoPass/releases/latest/download/appcast.xml

# The Sparkle release the app embeds (Package.resolved pins the same one) and the tarball
# the release job takes `generate_appcast` from.
SPARKLE_VERSION=2.9.6
SPARKLE_TOOLS_SHA256=52bf9e88cdd972fc0c81501377a880e90d47031bd8ca5462488f843e2609e192
